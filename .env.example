# Server only; never prefix secrets with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Public Supabase project URL and publishable key, used by account saves.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server only: random 32+ byte secret, also installed as private.server_secrets tickets.
SCAN_SIGNING_SECRET=
# Optional server overrides; otherwise uses the public VITE_ values above.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Native builds require a deployed HTTPS backend; never place Gemini keys here.
VITE_API_BASE_URL=
VITE_MAP_STYLE_URL=
# Server-only CORS allowlist (not authentication or abuse prevention).
ALLOWED_ORIGINS=capacitor://localhost,https://localhost
