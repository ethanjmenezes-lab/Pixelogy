# Server only; never prefix secrets with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Reserved for a future real leaderboard; unused by the local core.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

