{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "noEmitOnError": true,
    "rootDir": "."
  },
  "include": ["api/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
